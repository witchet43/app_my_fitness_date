# Values from Supabase Dashboard > Connect > API
# Publishable key may ship in the client. Never use secret/service_role keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# V23 QA identity gateway (all disabled by default; do not commit credentials)
# Use only on a local workstation or isolated DEV, NEVER in production.
MFD_APP_ENV=local
MFD_QA_AUTH_ENABLED=
MFD_QA_AUTH_ALLOWLIST=
MFD_SUPABASE_URL=
MFD_SUPABASE_PUBLISHABLE_KEY=
# For Flutter: --dart-define=MFD_QA_LOGIN_UI=true (QA only; false by default)
# For Flutter: --dart-define=MFD_API_BASE_URL=http://127.0.0.1:8080
